<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV launcher banner: the app logo centred on the dark/gold gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#0B0B0B" android:endColor="#2A2110" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/app_logo" android:gravity="center" android:width="140dp" android:height="140dp" />
</layer-list>
