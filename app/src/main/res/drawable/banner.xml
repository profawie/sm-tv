<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV launcher banner: gold "SM TV" on black. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#0B0B0B" android:endColor="#2A2110" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/logo" android:gravity="center" android:width="100dp" android:height="80dp" />
</layer-list>
